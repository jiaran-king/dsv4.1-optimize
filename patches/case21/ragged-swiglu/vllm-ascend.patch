diff --git a/vllm_ascend/ops/fused_moe/next20_ragged_swiglu.py b/vllm_ascend/ops/fused_moe/next20_ragged_swiglu.py
new file mode 100644
--- /dev/null
+++ b/vllm_ascend/ops/fused_moe/next20_ragged_swiglu.py
@@ -0,0 +1,58 @@
+"""Clipped SwiGLU on rows owned by the expert group list."""
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _ragged_swiglu_kernel(
+    x,
+    groups,
+    out,
+    limit: tl.constexpr,
+    capacity: tl.constexpr,
+    features: tl.constexpr,
+    group_count: tl.constexpr,
+    group_block: tl.constexpr,
+    cumulative: tl.constexpr,
+    tile_rows: tl.constexpr,
+    tile_columns: tl.constexpr,
+    programs: tl.constexpr,
+):
+    if cumulative:
+        rows = tl.load(groups + group_count - 1).to(tl.int32)
+    else:
+        group = tl.arange(0, group_block)
+        counts = tl.load(groups + group, group < group_count, other=0).to(tl.int32)
+        rows = tl.sum(counts, axis=0)
+    rows = tl.minimum(rows, capacity)
+    pid = tl.program_id(0)
+    row_offset = tl.arange(0, tile_rows)
+    column = tl.arange(0, tile_columns)
+    for i in range(pid, tl.cdiv(rows, tile_rows), programs):
+        row = i * tile_rows + row_offset
+        valid = (row[:, None] < rows) & (column[None, :] < features)
+        start = row[:, None] * (2 * features) + column[None, :]
+        gate = tl.load(x + start, valid, other=0).to(tl.float32)
+        value = tl.load(x + start + features, valid, other=0).to(tl.float32)
+        gate = tl.minimum(gate, limit)
+        value = tl.minimum(tl.maximum(value, -limit), limit)
+        silu = gate / (1.0 + tl.exp(-gate))
+        tl.store(out + row[:, None] * features + column[None, :], silu * value, valid)
+
+
+def ragged_swiglu(x, groups, group_list_type, limit, tile_rows=1):
+    """The downstream grouped matmul and combine use only the valid output rows."""
+    capacity, doubled_features = x.shape
+    features = doubled_features // 2
+    out = torch.empty((capacity, features), device=x.device, dtype=x.dtype)
+    programs = 48
+    group_count = groups.numel()
+    _ragged_swiglu_kernel[(programs,)](
+        x, groups, out, float(limit), capacity, features, group_count,
+        triton.next_power_of_2(group_count), group_list_type == 0, tile_rows,
+        triton.next_power_of_2(features),
+        programs,
+    )
+    return out
