diff --git a/vllm_ascend/core/next20_compact_kv.py b/vllm_ascend/core/next20_compact_kv.py
new file mode 100644
--- /dev/null
+++ b/vllm_ascend/core/next20_compact_kv.py
@@ -0,0 +1,239 @@
+"""Separate long-context and bounded-window storage on V4.1 Decode."""
+
+from dataclasses import replace
+import logging
+from math import ceil
+
+from vllm.v1.core.block_pool import BlockPool
+from vllm.v1.kv_cache_interface import CircularBufferSpec, KVCacheConfig, KVCacheTensor, UniformTypeKVCacheSpecs
+from vllm_ascend.core.kv_cache_interface import AscendMLAAttentionSpec, AscendSlidingWindowMLASpec
+
+
+logger = logging.getLogger(__name__)
+
+
+def plan_decode_cache(config, groups, available, specs, page_sizes, layer_tuples):
+    transfer = config.kv_transfer_config
+    parallel = config.parallel_config
+    if (
+        transfer is None
+        or transfer.kv_connector != "MooncakeHybridConnector"
+        or transfer.kv_role != "kv_consumer"
+        or config.cache_config.enable_prefix_caching
+        or getattr(config.cache_config, "swa_bounded_replay", False)
+        or config.cache_config.num_gpu_blocks_override is not None
+        or parallel.tensor_parallel_size != 1
+        or parallel.pipeline_parallel_size != 1
+        or parallel.decode_context_parallel_size != 1
+        or transfer.get_from_extra_config("prefill", {}).get("pp_size", 1) != 1
+    ):
+        return None
+    if any(not isinstance(group.kv_cache_spec, UniformTypeKVCacheSpecs) for group in groups):
+        return None
+
+    seqs = config.scheduler_config.max_num_seqs
+    tokens = config.scheduler_config.max_num_batched_tokens
+    spec = config.speculative_config
+    lookahead = spec.num_speculative_tokens if spec is not None else 0
+    short_blocks = 1  # block zero is reserved by BlockPool
+    for group in groups:
+        group_specs = tuple(group.kv_cache_spec.kv_cache_specs.values())
+        if all(isinstance(item, CircularBufferSpec) for item in group_specs):
+            short_blocks += seqs
+        elif all(isinstance(item, AscendSlidingWindowMLASpec) for item in group_specs):
+            block = group_specs[0].block_size
+            window = max(item.sliding_window + getattr(item, "extra_retained_tokens", 0) for item in group_specs)
+            # Keep overlapping in-flight batches and per-request partial pages.
+            # Admission also checks the actual free short-block count.
+            short_blocks += seqs * (2 + ceil((window - 1 + lookahead) / block)) + ceil(2 * tokens / block)
+        elif not all(isinstance(item, AscendMLAAttentionSpec) for item in group_specs):
+            return None
+
+    longs = []
+    shorts = []
+    padded = dict(specs)
+    for original_stride, names in zip(page_sizes, layer_tuples, strict=True):
+        long_layers = tuple(n for n in names if isinstance(specs[n], AscendMLAAttentionSpec))
+        short_layers = tuple(n for n in names if n not in long_layers)
+        if len(long_layers) != 2 or not short_layers or long_layers != tuple(names[:2]):
+            return None
+        kv, index = long_layers
+        kv_bytes = specs[kv].unpadded_page_size_bytes
+        packed_bytes = kv_bytes + specs[index].unpadded_page_size_bytes
+        long_stride = 128 * ceil(packed_bytes / 128)
+        if long_stride > original_stride or kv_bytes % 128:
+            return None
+        padded[kv] = replace(specs[kv], page_size_padded=kv_bytes)
+        padded[index] = replace(specs[index], page_size_padded=long_stride - kv_bytes)
+        longs.append((long_layers, long_stride))
+        shorts.append((short_layers, original_stride))
+
+    short_bytes = short_blocks * sum(stride for _, stride in shorts)
+    long_stride_sum = sum(stride for _, stride in longs)
+    long_blocks = (available - short_bytes) // long_stride_sum
+    if long_blocks <= max(short_blocks, available // sum(page_sizes)):
+        return None
+    tensors = [
+        KVCacheTensor(size=blocks * stride, layers=list(layers), offset=0, layer_stride=0, block_stride=stride)
+        for geometry, blocks in ((longs, long_blocks), (shorts, short_blocks))
+        for layers, stride in geometry
+    ]
+    cache_groups = [
+        replace(group, kv_cache_spec=UniformTypeKVCacheSpecs.from_specs({n: padded[n] for n in group.layer_names}))
+        for group in groups
+    ]
+    logger.info(
+        "Compact Decode KV layout: %d long blocks at %d bytes, %d short blocks at %d total bytes",
+        long_blocks, long_stride_sum, short_blocks, short_bytes,
+    )
+    return KVCacheConfig(
+        num_blocks=long_blocks,
+        kv_cache_tensors=tensors,
+        kv_cache_groups=cache_groups,
+        prefix_cache_retention_interval=config.cache_config.prefix_cache_retention_interval,
+    )
+
+
+def physical_block_counts(config):
+    return {
+        layer: tensor.size // tensor.block_stride
+        for tensor in config.kv_cache_tensors
+        if tensor.block_stride > 0
+        for layer in tensor.layers
+    }
+
+
+class CompactCacheZeroer:
+    """Clear only the arena that owns the newly allocated block."""
+
+    def __init__(self, long, short, long_blocks, short_blocks):
+        self.long = long
+        self.short = short
+        self.long_blocks = long_blocks
+        self.short_blocks = short_blocks
+
+    def zero_block_ids(self, block_ids):
+        long, short = [], []
+        for block_id in block_ids:
+            if block_id < self.long_blocks:
+                long.append(block_id)
+            else:
+                short.append(block_id - self.long_blocks)
+        if any(i < 0 for i in long) or any(i >= self.short_blocks for i in short):
+            raise ValueError("A zeroing operation is outside its physical KV cache arena")
+        self.long.zero_block_ids(long)
+        self.short.zero_block_ids(short)
+
+    def warmup(self, num_kv_blocks):
+        self.long.warmup(min(num_kv_blocks, self.long_blocks))
+        self.short.warmup(min(num_kv_blocks, self.short_blocks))
+
+
+def split_cache_zeroer(runner, factory):
+    config = runner.kv_cache_config
+    counts = physical_block_counts(config)
+    if not any(n < config.num_blocks for n in counts.values()):
+        return None
+    groups = {}
+    for pack in runner.attn_groups:
+        for group in pack:
+            owned = [layer for layer in group.layer_names if layer in counts]
+            if owned:
+                count, = {counts[layer] for layer in owned}
+                groups.setdefault(count, []).append(replace(group, layer_names=owned))
+    short_blocks, = groups.keys() - {config.num_blocks}
+
+    def build(count):
+        return factory(
+            runner.device, attn_groups_iter=groups[count], kernel_block_sizes=runner.kernel_block_sizes,
+            static_forward_context=runner.compilation_config.static_forward_context,
+            num_blocks=count, cache_dtype=runner.cache_config.cache_dtype,
+        )
+
+    return CompactCacheZeroer(build(config.num_blocks), build(short_blocks), config.num_blocks, short_blocks)
+
+
+def configure_short_pool(long_pool, config, enable_caching, enable_events, hash_block_size, collector):
+    counts = physical_block_counts(config)
+    sizes = [
+        {counts.get(layer, config.num_blocks) for layer in group.layer_names}
+        for group in config.kv_cache_groups
+    ]
+    if not any(len(group) == 1 and next(iter(group)) < config.num_blocks for group in sizes):
+        return None, frozenset()
+    if enable_caching or any(len(group) != 1 for group in sizes):
+        raise ValueError("Compact Decode requires independent, uniform, uncached KV groups")
+    short_ids = frozenset(i for i, group in enumerate(sizes) if next(iter(group)) < config.num_blocks)
+    other = {next(iter(sizes[i])) for i in short_ids}
+    short_blocks, = other
+    short = BlockPool(
+        num_gpu_blocks=short_blocks, enable_caching=False, hash_block_size=hash_block_size,
+        enable_kv_cache_events=enable_events, metrics_collector=collector,
+    )
+    short_objects = {id(block) for block in short.blocks}
+    free_long = long_pool.free_blocks
+
+    def free_to_owner(blocks):
+        ordinary, bounded = [], []
+        for block in blocks:
+            (bounded if id(block) in short_objects else ordinary).append(block)
+        free_long(ordinary)
+        short.free_blocks(bounded)
+
+    # Deferred frees arrive here after an asynchronous step, with block
+    # objects from both arenas. IDs can repeat across the two arenas.
+    long_pool.free_blocks = free_to_owner
+    return short, short_ids
+
+
+def compact_required_blocks(coordinator, request_id, num_tokens, new_computed_blocks, total_computed_tokens,
+                            num_local_computed_tokens, num_tokens_main_model, apply_admission_cap, prefill_end):
+    long, short = 0, 0
+    if coordinator.retention_interval != 0:
+        prefill_end = 0
+    for i, manager in enumerate(coordinator.single_type_managers):
+        blocks = manager.get_num_blocks_to_allocate(
+            request_id, num_tokens, new_computed_blocks[i], total_computed_tokens,
+            num_local_computed_tokens, num_tokens_main_model, apply_admission_cap=apply_admission_cap,
+            prefill_end=prefill_end,
+        )
+        if i in coordinator._next20_short_ids:
+            short += blocks
+        else:
+            long += blocks
+    if short > coordinator._next20_short_pool.get_num_free_blocks():
+        return coordinator.block_pool.get_num_free_blocks() + 1
+    return long
+
+
+def prefill_page_mapping(config):
+    counts = physical_block_counts(config)
+    if not any(value < config.num_blocks for value in counts.values()):
+        return None
+
+    from vllm_ascend.models.deepseek_v41.cache_config import _specs_from_groups, get_layer_tuples
+
+    _, original = get_layer_tuples(_specs_from_groups(config.kv_cache_groups))
+    by_layer = {name: i for i, group in enumerate(original) for name in group}
+    mapping = [next(iter({by_layer[layer] for layer in tensor.layers})) for tensor in config.kv_cache_tensors]
+    if len(mapping) != 2 * len(original):
+        raise ValueError("Compact Decode pages do not correspond to the original Prefill slots")
+    return mapping
+
+
+def append_page_reads(src, dst, lengths, local_base, remote_base, local_stride, remote_stride,
+                      block_len, grouped_remote_blocks, grouped_local_blocks):
+    if block_len > min(local_stride, remote_stride):
+        raise ValueError("KV transfer page length exceeds a physical page")
+    for remote, local in zip(grouped_remote_blocks, grouped_local_blocks, strict=True):
+        if len(remote) != len(local):
+            raise ValueError("KV transfer block counts differ")
+        if local_stride == remote_stride == block_len:
+            src.append(local_base + local[0] * local_stride)
+            dst.append(remote_base + remote[0] * remote_stride)
+            lengths.append(len(local) * block_len)
+        else:
+            for remote_block, local_block in zip(remote, local, strict=True):
+                src.append(local_base + local_block * local_stride)
+                dst.append(remote_base + remote_block * remote_stride)
+                lengths.append(block_len)
