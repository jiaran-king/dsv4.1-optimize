+def _limit_a3_decode_mc2_graphs(vllm_config: VllmConfig) -> None:
+    from vllm.config import CUDAGraphMode
+    from vllm_ascend.ascend_forward_context import _a3_decode_mc2_capacity
+
+    config = vllm_config.compilation_config
+    sizes = config.cudagraph_capture_sizes
+    if config.cudagraph_mode != CUDAGraphMode.FULL_DECODE_ONLY or not sizes:
+        return
+
+    # A3 AllToAll is the eager fallback above the MC2 window. Keep it out
+    # of full-Decode capture, where its extra stream cannot be joined.
+    cap = _a3_decode_mc2_capacity(vllm_config, max(sizes))
+    supported = [size for size in sizes if size <= cap]
+    if len(supported) == len(sizes):
+        return
+    if not supported:
+        raise ValueError("The configured HCCL window cannot capture the minimum Decode batch")
+
+    logger.info(
+        "A3 Decode graph window: %d to %d tokens; larger batches use eager AllToAll",
+        max(sizes),
+        supported[-1],
+    )
+    config.max_cudagraph_capture_size = supported[-1]
+    config.cudagraph_capture_sizes = supported
+    update_cudagraph_capture_sizes(vllm_config, supported)
