+def _a3_decode_mc2_capacity(vllm_config: VllmConfig, token_capacity: int) -> int:
+    """Do not select A3 MC2 for a batch that exceeds its HCCL window."""
+    parallel = vllm_config.parallel_config
+    ascend_config = get_ascend_config()
+    # This path uses the ordinary A3 MC2 dispatch/combine pair and a uniform
+    # batch across DP ranks. Other hardware and fused/elastic modes own their
+    # own buffer contracts.
+    if (
+        get_current_hardware_profile().moe_comm_policy != MoECommPolicy.FUSED_OR_CAPACITY
+        or not _is_decode_only_node(vllm_config)
+        or not parallel.enable_expert_parallel
+        or parallel.tensor_parallel_size != 1
+        or parallel.prefill_context_parallel_size != 1
+        or getattr(parallel, "enable_eplb", False)
+        or ascend_config.enable_fused_mc2
+        or ascend_config.enable_prefill_mc2
+    ):
+        return token_capacity
+    configured_mib = os.environ.get("HCCL_BUFFSIZE")
+    if not configured_mib or not configured_mib.isdecimal():
+        return token_capacity
+
+    ep_size = parallel.world_size_across_dp // parallel.pipeline_parallel_size
+    models = [vllm_config.model_config]
+    draft = vllm_config.speculative_config
+    if draft is not None and draft.draft_model_config is not None:
+        models.append(draft.draft_model_config)
+
+    window_bytes_per_token = 0
+    for model in models:
+        text = model.hf_text_config
+        experts = model.get_num_experts()
+        if experts < 1:
+            continue
+        hidden = text.hidden_size
+        topk = getattr(text, "num_experts_per_tok", getattr(text, "top_k_experts", experts))
+        # CANN 8.5 A3 DispatchV2/CombineV2 require double buffering.
+        # Align the receive payload plus its 44-byte header to 512 bytes.
+        # Reserve the shared-expert term conservatively, even though this
+        # CANN path executes the shared expert separately.
+        feature_bytes = 2 * hidden
+        send_bytes = math.ceil(feature_bytes / 512) * 512
+        receive_bytes = math.ceil((math.ceil(feature_bytes / 32) * 32 + 44) / 512) * 512
+        local_experts = math.ceil(experts / ep_size)
+        shared_experts = getattr(text, "n_shared_experts", 0) or 0
+        footprint = 2 * (local_experts * ep_size * receive_bytes + (topk + shared_experts) * send_bytes)
+        window_bytes_per_token = max(window_bytes_per_token, footprint)
+    if not window_bytes_per_token:
+        return token_capacity
+
+    # Keep the documented minimum space for the communicator metadata.
+    budget_mib = int(configured_mib)
+    allowed = max(0, (budget_mib - 2) * 1024**2 // window_bytes_per_token)
+    limited = min(token_capacity, allowed)
+    if limited < token_capacity:
+        logger.info(
+            "A3 Decode MC2: HCCL window %d MiB limits MC2 to %d tokens per rank; "
+            "larger batches use the existing non-MC2 path",
+            budget_mib,
+            limited,
+        )
+    return limited
+
